{
  "name": "nostr-contact-card",
  "version": "0.3.0",
  "description": "One QR or link that makes a stranger a contact, names their box, and starts a bond. Build, sign, read and refresh contact cards; verify the Link address card inside.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vectors/contact-card.json": "./vectors/contact-card.json"
  },
  "files": [
    "dist",
    "vectors/contact-card.json",
    "LICENCE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nostr",
    "contact",
    "card",
    "qr",
    "rendezvous",
    "bond",
    "ed25519",
    "bip-340"
  ],
  "author": "ForgeSworn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forgesworn/nostr-contact-card"
  },
  "homepage": "https://github.com/forgesworn/nostr-contact-card#readme",
  "bugs": {
    "url": "https://github.com/forgesworn/nostr-contact-card/issues"
  },
  "funding": {
    "type": "lightning",
    "url": "lightning:profusemeat89@walletofsatoshi.com"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "provenance": true
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
